#!/usr/bin/env python3
"""
Owns the camera while it is in live mode, and serves everything that needs it.

Replaces the older camera-record. The reason is a hard constraint: only one
process can hold /dev/video0 open. A separate recorder and a separate preview
grabber cannot coexist -- the second one just fails. So a single ffmpeg reads
the camera once and fans out:

    output 0 (optional)  -> Matroska recording on the SD card
    output 1 (always)    -> /run/camera-drive/live.jpg, rewritten every frame

Because both outputs are `-c:v copy`, the preview costs nothing: it is the
camera's own JPEG frame written straight to tmpfs. A snapshot is therefore a
plain file copy at full native quality, not a re-encode of a re-encode.

Control is a JSON file in the same tmpfs directory, written by the web app.
Both run as joao, so no sudo and no socket handling is needed:

    /run/camera-drive/control.json
        {"preview": bool, "recording": bool, "snapshot_seq": int}

Bumping snapshot_seq asks for a photo. Flipping recording restarts ffmpeg with
or without the recording output, which costs a ~4 second gap -- acceptable,
and far simpler than trying to add and remove a muxer at runtime.

preview defaults to FALSE and ffmpeg only runs when preview or recording is on.
Plugging the camera in therefore does not start the sensor: it sits idle until
you actually open the viewfinder. That keeps the camera cool, saves power, and
avoids a 20-year-old webcam streaming into a wall for hours.
"""

from __future__ import annotations

import json
import os
import re
import signal
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

RUN = Path("/run/camera-drive")
LIVE_JPG = RUN / "live.jpg"
CONTROL = RUN / "control.json"

ROOT = Path("/srv/camera-drive")
VIDEO_DIR = ROOT / "video"
SNAP_DIR = ROOT / "media" / "snapshots"
STATUS_PATH = ROOT / "recstatus.json"
LOG_PATH = ROOT / "record.log"

CAMERA_NAME_HINTS = ("cam 3200", "slim 3200", "aiptek")
WIDTH, HEIGHT = 464, 480
MIN_FREE_BYTES = 512 * 1024 * 1024
START_RETRIES = 4
POLL = 0.4

_proc: subprocess.Popen | None = None
_stop = False


def log(msg: str) -> None:
    line = f"{datetime.now(timezone.utc).isoformat(timespec='seconds')} [live] {msg}"
    print(line, flush=True)
    try:
        with LOG_PATH.open("a") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


def read_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json_atomic(path: Path, data) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, path)


def set_status(**kw) -> None:
    cur = read_json(STATUS_PATH, {})
    cur.update(kw)
    cur["updated"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    try:
        write_json_atomic(STATUS_PATH, cur)
    except OSError as exc:
        log(f"could not write status: {exc}")


# --------------------------------------------------------------------------
# device discovery
# --------------------------------------------------------------------------

def find_video_device() -> str | None:
    """
    Match on card name, never on device number. The Pi has a dozen /dev/video*
    nodes of its own (bcm2835-codec, bcm2835-isp, rpivid); picking the lowest
    would grab a hardware codec instead of the camera.
    """
    for dev in sorted(Path("/dev").glob("video*"),
                      key=lambda p: int(re.sub(r"\D", "", p.name) or 0)):
        try:
            out = subprocess.run(["v4l2-ctl", "-d", str(dev), "--info"],
                                 capture_output=True, text=True,
                                 timeout=5).stdout.lower()
        except (OSError, subprocess.SubprocessError):
            continue
        if any(h in out for h in CAMERA_NAME_HINTS) and "capture" in out:
            return str(dev)
    return None


def find_audio_device() -> str | None:
    try:
        out = subprocess.run(["arecord", "-l"], capture_output=True,
                             text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        m = re.match(r"card (\d+): (\S+)", line.strip())
        if m and any(h in m.group(2).lower()
                     for h in ("c3200", "cam3200", "aiptek")):
            return f"hw:{m.group(1)},0"
    for line in out.splitlines():
        m = re.match(r"card (\d+): (\S+).*USB", line.strip())
        if m:
            return f"hw:{m.group(1)},0"
    return None


def free_bytes() -> int:
    st = os.statvfs(ROOT)
    return st.f_bavail * st.f_frsize


# --------------------------------------------------------------------------
# ffmpeg
# --------------------------------------------------------------------------

def build_cmd(video_dev: str, audio_dev: str | None,
              rec_dest: Path | None) -> list[str]:
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "warning", "-nostdin",
        # No -input_format: ffmpeg has no name for this driver's JPEG fourcc,
        # and naming mjpeg makes the stream fail to open outright.
        # No -use_wallclock_as_timestamps: it yields non-monotonic DTS here.
        "-f", "v4l2", "-video_size", f"{WIDTH}x{HEIGHT}", "-i", video_dev,
    ]
    if audio_dev and rec_dest:
        # -channels, not -ac. -ac is a codec option that never reaches the
        # ALSA demuxer, so ffmpeg asks a mono-only mic for stereo and dies.
        cmd += ["-f", "alsa", "-channels", "1", "-sample_rate", "48000",
                "-thread_queue_size", "1024", "-i", audio_dev]

    if rec_dest:
        cmd += ["-map", "0:v", "-c:v", "copy"]
        if audio_dev:
            # Aligns the v4l2 and ALSA clocks; without it the file claims a
            # duration several times its real length.
            cmd += ["-map", "1:a", "-af", "aresample=async=1:first_pts=0",
                    "-c:a", "pcm_s16le"]
        # Matroska, not AVI: recordings normally end by the power being cut,
        # and Matroska stays seekable up to the truncation point.
        cmd += ["-f", "matroska", "-y", str(rec_dest)]

    # The preview. Always present, always a straight copy of the camera's own
    # JPEG frame, written to tmpfs so it never touches the SD card.
    cmd += ["-map", "0:v", "-c:v", "copy", "-f", "image2", "-update", "1",
            "-y", str(LIVE_JPG)]
    return cmd


def start_ffmpeg(video_dev: str, audio_dev: str | None,
                 rec_dest: Path | None) -> bool:
    global _proc
    cmd = build_cmd(video_dev, audio_dev, rec_dest)
    log(f"starting ffmpeg (recording={'yes -> ' + rec_dest.name if rec_dest else 'no'})")

    for attempt in range(1, START_RETRIES + 1):
        _proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.PIPE, text=True)
        time.sleep(4)
        if _proc.poll() is None:
            return True
        err = (_proc.stderr.read() or "").strip().splitlines()
        tail = [e for e in err if "QBUF" not in e][-3:] or ["(no output)"]
        log(f"start attempt {attempt}/{START_RETRIES}: {' | '.join(tail)}")
        if attempt < START_RETRIES:
            time.sleep(2)
    set_status(state="error", last_error="ffmpeg would not start")
    return False


def stop_ffmpeg() -> None:
    """SIGINT and wait. ffmpeg needs real time to finalise a Matroska file."""
    global _proc
    if not _proc or _proc.poll() is not None:
        return
    _proc.send_signal(signal.SIGINT)
    for _ in range(60):
        if _proc.poll() is not None:
            return
        time.sleep(0.25)
    _proc.terminate()
    time.sleep(2)
    if _proc.poll() is None:
        _proc.kill()


# --------------------------------------------------------------------------
# main loop
# --------------------------------------------------------------------------

def take_snapshot() -> str | None:
    """A snapshot is just the newest preview frame, which is the camera's
    own untouched JPEG. No decode, no re-encode, no quality loss."""
    if not LIVE_JPG.exists() or LIVE_JPG.stat().st_size < 1024:
        log("snapshot requested but no live frame available")
        return None
    SNAP_DIR.mkdir(parents=True, exist_ok=True)
    name = datetime.now().strftime("SNAP_%Y-%m-%d_%H%M%S.jpg")
    dest = SNAP_DIR / name
    # Copy via a temp file so the web app never sees a half-written photo.
    tmp = dest.with_suffix(".part")
    shutil.copyfile(LIVE_JPG, tmp)
    os.replace(tmp, dest)
    log(f"snapshot {name} ({dest.stat().st_size} bytes)")
    return name


def handle_signal(signum, frame) -> None:
    global _stop
    log(f"got signal {signum}, shutting down")
    _stop = True


def main() -> int:
    global _stop
    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    RUN.mkdir(parents=True, exist_ok=True)
    VIDEO_DIR.mkdir(parents=True, exist_ok=True)

    # udev fires when the USB device appears; the V4L2 node and ALSA card
    # follow a beat later.
    video_dev = None
    for _ in range(20):
        video_dev = find_video_device()
        if video_dev:
            break
        time.sleep(0.5)
    if not video_dev:
        log("no camera video device found")
        set_status(state="off", last_error="no V4L2 capture device")
        return 1

    audio_dev = None
    for _ in range(6):
        audio_dev = find_audio_device()
        if audio_dev:
            break
        time.sleep(0.5)
    log(f"video={video_dev} audio={audio_dev or 'none'}")

    # Start idle. The camera is plugged in but the sensor is not streaming
    # until someone asks for the viewfinder or hits record.
    write_json_atomic(CONTROL, {"preview": False, "recording": False,
                                "snapshot_seq": 0})
    LIVE_JPG.unlink(missing_ok=True)
    seen_seq = 0
    capturing = False
    recording = False
    rec_dest: Path | None = None
    set_status(state="idle", recording=False, file=None,
               audio=bool(audio_dev), last_error=None)

    while not _stop:
        time.sleep(POLL)

        # ffmpeg died -- usually means the camera was unplugged.
        if capturing and _proc and _proc.poll() is not None:
            if not Path(video_dev).exists():
                log("camera disconnected")
                break
            log("ffmpeg exited unexpectedly, restarting")
            if not start_ffmpeg(video_dev, audio_dev,
                                rec_dest if recording else None):
                break
            continue

        # Camera can also be unplugged while idle, when no ffmpeg is running
        # to notice it for us.
        if not capturing and not Path(video_dev).exists():
            log("camera disconnected while idle")
            break

        ctl = read_json(CONTROL, {})

        seq = int(ctl.get("snapshot_seq", 0) or 0)
        if seq != seen_seq:
            seen_seq = seq
            if capturing:
                set_status(last_snapshot=take_snapshot())
            else:
                log("snapshot ignored: viewfinder is off")

        want_rec = bool(ctl.get("recording", False))
        want_cap = bool(ctl.get("preview", False)) or want_rec

        if want_rec and not recording and free_bytes() < MIN_FREE_BYTES:
            log("refusing to record: card nearly full")
            set_status(last_error="card nearly full")
            write_json_atomic(CONTROL, {**ctl, "recording": False})
            continue

        if want_cap == capturing and want_rec == recording:
            continue

        # Anything that changes the ffmpeg output set means restarting it.
        stop_ffmpeg()
        if recording and rec_dest and rec_dest.exists():
            log(f"finished {rec_dest.name} ({rec_dest.stat().st_size} bytes)")

        rec_dest = None
        if want_rec:
            stamp = datetime.now().strftime("%Y-%m-%d_%H%M%S")
            rec_dest = VIDEO_DIR / f"{stamp}.mkv"

        if want_cap:
            if not start_ffmpeg(video_dev, audio_dev, rec_dest):
                break
        else:
            # Nothing wants the sensor; drop the stale preview frame so the
            # UI does not show a frozen image as though it were live.
            LIVE_JPG.unlink(missing_ok=True)
            log("sensor idle")

        capturing, recording = want_cap, want_rec
        set_status(state="live" if capturing else "idle",
                   recording=recording,
                   file=rec_dest.name if rec_dest else None,
                   last_error=None)

    stop_ffmpeg()
    if rec_dest and rec_dest.exists():
        log(f"finished {rec_dest.name} ({rec_dest.stat().st_size} bytes)")
    LIVE_JPG.unlink(missing_ok=True)
    set_status(state="off", recording=False, file=None)
    log("stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
