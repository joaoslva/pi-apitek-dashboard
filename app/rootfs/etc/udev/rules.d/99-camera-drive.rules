# Aiptek Cam 3200 -- camera-drive
#
# The camera reports a DIFFERENT USB product id depending on the mode its
# physical switch is in, which is what lets the Pi react appropriately without
# any configuration:
#
#   08ca:2023  "Cam 3200"   -> USB mass storage. Offload the photos.
#   08ca:2022  "Slim 3200"  -> live/webcam mode. (Handled by the camcorder unit.)
#
# Reload with:  sudo udevadm control --reload && sudo udevadm trigger

# --- storage mode: offload ------------------------------------------------
# Matched on the partition rather than the whole disk, so we get exactly one
# trigger per insertion and a device node that is actually mountable.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", \
  ATTRS{idVendor}=="08ca", ATTRS{idProduct}=="2023", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}="camera-offload@%k.service"

# Stop udisks/desktop automounters racing us for the same device. Nothing else
# on this box should ever touch the camera's filesystem.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", \
  ATTRS{idVendor}=="08ca", ATTRS{idProduct}=="2023", \
  ENV{UDISKS_IGNORE}="1"

# --- live mode: live view + camcorder -------------------------------------
# camera-live owns /dev/video0 for as long as the camera is plugged in this
# mode, and serves both the preview and any recording from one capture. Only
# one process can hold the V4L2 device, so this must be the only thing that
# opens it -- do not add a second unit here.
#
# There is deliberately no matching "remove" rule. Running systemctl from a
# udev rule can deadlock, and it is unnecessary: when the camera is unplugged
# its V4L2 node disappears, ffmpeg exits, and camera-live finalises whatever
# it was writing and returns on its own.
ACTION=="add", SUBSYSTEM=="usb", ENV{ID_VENDOR_ID}=="08ca", \
  ENV{ID_MODEL_ID}=="2022", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}="camera-live.service"
