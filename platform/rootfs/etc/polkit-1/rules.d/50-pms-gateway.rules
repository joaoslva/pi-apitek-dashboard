// Everything the pms-gateway user may do beyond an ordinary user, and nothing
// else: anything not granted here is refused outright rather than falling
// through to the defaults.

polkit.addRule(function (action, subject) {
    if (subject.user !== "pms-gateway") {
        return polkit.Result.NOT_HANDLED;
    }

    // Start and stop the services it manages. Keep this list equal to the
    // [run] units of services/*/service.toml.
    var units = ["camera-drive-web.service", "etherpad.service"];
    var verbs = ["start", "stop", "restart"];
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        if (units.indexOf(action.lookup("unit")) >= 0 &&
            verbs.indexOf(action.lookup("verb")) >= 0) {
            return polkit.Result.YES;
        }
        return polkit.Result.NO;
    }

    // Owner-only power actions in the admin UI.
    var power = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions"
    ];
    // Network modes: switch connections, save WiFi profiles, scan.
    var network = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.wifi.scan"
    ];
    if (power.indexOf(action.id) >= 0 || network.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }

    return polkit.Result.NO;
});
