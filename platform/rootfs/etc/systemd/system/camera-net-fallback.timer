[Unit]
Description=Periodically check camera-drive network reachability

[Timer]
# The script waits for the radio (up ~21 s after power on) and for
# NetworkManager's own join, so starting early does not second-guess it.
OnBootSec=15s
OnUnitActiveSec=30s
AccuracySec=2s

[Install]
WantedBy=timers.target
