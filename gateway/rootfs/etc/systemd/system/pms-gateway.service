[Unit]
Description=pi-mobile-server gateway (TLS, login, portal, service proxy)
After=network.target

[Service]
Type=exec
User=pms-gateway
Group=pms-gateway
ExecStart=/usr/local/bin/pms-gateway serve -config /etc/pms/gateway.toml
Restart=on-failure
RestartSec=3

# Database and generated certificate live here, private to the service.
StateDirectory=pms-gateway
StateDirectoryMode=0700
UMask=0077

# Binding 443 (and 80 once it redirects) is the only privilege it has.
# Starting and stopping services goes through polkit (50-pms-gateway.rules).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_NETLINK: listing interface addresses for a generated certificate.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Two concurrent argon2id hashes are 38 MiB; the rest is small.
Environment=GOMEMLIMIT=64MiB
MemoryHigh=80M
MemoryMax=120M

[Install]
WantedBy=multi-user.target
