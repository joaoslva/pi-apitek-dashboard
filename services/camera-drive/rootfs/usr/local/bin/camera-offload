#!/usr/bin/env python3
"""
Offload an Aiptek Cam 3200 (USB id 08ca:2023, mass-storage mode) onto the Pi.

Invoked by udev via camera-offload@.service when the camera's block device
appears. Copies every media file off the camera, verifies each one by hash,
and never deletes anything -- wiping the camera is a deliberate action taken
from the web UI.

Design notes that are not obvious:

* The camera's filenames reset to IMG_0001 after every format, so names alone
  cannot identify a photo. We key on the SHA-256 of the content instead and
  keep an index, which makes re-plugging the camera a cheap no-op instead of
  a source of duplicates.
* The camera's real-time clock is dead (EXIF reads as 2001), so files are
  organised by ingest time, never by their own timestamps.
* The card gets littered with System Volume Information/ and .fseventsd/ by
  Windows and macOS. Those are not media.
* The card is mounted READ-ONLY. This path never needs to write to the camera,
  and a read-only mount cannot corrupt a FAT filesystem on power loss.
"""

from __future__ import annotations

import errno
import fcntl
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path("/srv/camera-drive")
MEDIA = ROOT / "media"
INDEX_PATH = ROOT / "index.json"
STATUS_PATH = ROOT / "status.json"
LOCK_PATH = Path("/run/camera-drive.lock")
MOUNT_POINT = Path("/run/camera-drive/mnt")
LOG_PATH = ROOT / "offload.log"

MEDIA_SUFFIXES = {".jpg", ".jpeg", ".avi", ".mov", ".mp4", ".wav", ".png"}
IGNORED_DIRS = {"System Volume Information", ".fseventsd", ".Spotlight-V100",
                ".Trashes", "LOST.DIR", "FOUND.000"}

CHUNK = 1024 * 1024


# --------------------------------------------------------------------------
# status LED
# --------------------------------------------------------------------------

def _find_led() -> Path | None:
    """The Zero 2 W's onboard LED is ACT on some kernels, led0 on others."""
    for name in ("ACT", "led0"):
        p = Path("/sys/class/leds") / name
        if (p / "brightness").exists():
            return p
    return None


class Led:
    """The only feedback channel on a headless box with no screen."""

    def __init__(self) -> None:
        self.path = _find_led()
        self._saved_trigger: str | None = None
        if self.path:
            try:
                # Read the active trigger, marked [like_this] in the file.
                raw = (self.path / "trigger").read_text()
                for tok in raw.split():
                    if tok.startswith("["):
                        self._saved_trigger = tok.strip("[]")
                (self.path / "trigger").write_text("none")
            except OSError:
                self.path = None

    def _set(self, on: bool) -> None:
        if not self.path:
            return
        try:
            (self.path / "brightness").write_text("1" if on else "0")
        except OSError:
            pass

    def blink(self, times: int, on: float = 0.1, off: float = 0.1) -> None:
        for _ in range(times):
            self._set(True)
            time.sleep(on)
            self._set(False)
            time.sleep(off)

    def restore(self) -> None:
        if self.path and self._saved_trigger:
            try:
                (self.path / "trigger").write_text(self._saved_trigger)
            except OSError:
                pass


# --------------------------------------------------------------------------
# helpers
# --------------------------------------------------------------------------

def log(msg: str) -> None:
    line = f"{datetime.now(timezone.utc).isoformat(timespec='seconds')} {msg}"
    print(line, flush=True)
    try:
        ROOT.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        while chunk := fh.read(CHUNK):
            h.update(chunk)
    return h.hexdigest()


def read_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return default


def write_json(path: Path, data) -> None:
    """Write atomically -- a half-written index is worse than none."""
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, path)
    fd = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def set_status(**kw) -> None:
    status = read_json(STATUS_PATH, {})
    status.update(kw)
    status["updated"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    write_json(STATUS_PATH, status)


def is_media(path: Path) -> bool:
    return path.suffix.lower() in MEDIA_SUFFIXES


def wait_for_device(dev: Path, timeout: float = 15.0) -> bool:
    """udev can fire slightly before the node is usable."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if dev.exists():
            return True
        time.sleep(0.4)
    return False


def mount_ro(dev: Path) -> bool:
    MOUNT_POINT.mkdir(parents=True, exist_ok=True)
    if os.path.ismount(MOUNT_POINT):
        subprocess.run(["umount", str(MOUNT_POINT)], check=False,
                       capture_output=True)
    res = subprocess.run(
        ["mount", "-o", "ro,noatime,nosuid,nodev,noexec,uid=0,gid=0",
         str(dev), str(MOUNT_POINT)],
        capture_output=True, text=True,
    )
    if res.returncode != 0:
        log(f"mount failed: {res.stderr.strip()}")
        return False
    return True


def umount() -> None:
    for _ in range(5):
        if not os.path.ismount(MOUNT_POINT):
            return
        res = subprocess.run(["umount", str(MOUNT_POINT)],
                             capture_output=True, text=True)
        if res.returncode == 0:
            return
        time.sleep(1.0)
    log("warning: could not unmount cleanly")


# --------------------------------------------------------------------------
# the offload itself
# --------------------------------------------------------------------------

def collect_files(root: Path) -> list[Path]:
    found: list[Path] = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in IGNORED_DIRS]
        for name in filenames:
            p = Path(dirpath) / name
            if is_media(p):
                found.append(p)
    return sorted(found)


def offload(dev: Path, led: Led) -> int:
    if not wait_for_device(dev):
        log(f"device {dev} never appeared")
        return 1

    if not mount_ro(dev):
        return 1

    try:
        files = collect_files(MOUNT_POINT)
        log(f"found {len(files)} media file(s) on the camera")

        if not files:
            set_status(state="idle", last_result="nothing to copy",
                       last_copied=0, last_skipped=0)
            led.blink(2, 0.4, 0.2)
            return 0

        index = read_json(INDEX_PATH, {})
        stamp = datetime.now().strftime("%Y-%m-%d_%H%M%S")
        dest_dir = MEDIA / stamp

        copied = skipped = failed = 0
        total_bytes = 0

        set_status(state="copying", total=len(files), done=0)

        for n, src in enumerate(files, start=1):
            try:
                digest = sha256(src)
            except OSError as exc:
                log(f"unreadable {src.name}: {exc}")
                failed += 1
                continue

            if digest in index:
                skipped += 1
                log(f"[{n}/{len(files)}] {src.name} already held, skipping")
                set_status(done=n)
                continue

            dest_dir.mkdir(parents=True, exist_ok=True)
            dest = dest_dir / src.name
            # Names repeat across dumps; disambiguate rather than overwrite.
            if dest.exists():
                dest = dest_dir / f"{dest.stem}_{digest[:8]}{dest.suffix}"

            try:
                shutil.copy2(src, dest)
                # Verify what actually landed on disk, not what we think we
                # wrote. This is the whole point of the exercise.
                if sha256(dest) != digest:
                    log(f"VERIFY FAILED for {src.name}, removing copy")
                    dest.unlink(missing_ok=True)
                    failed += 1
                    continue
            except OSError as exc:
                log(f"copy failed {src.name}: {exc}")
                failed += 1
                continue

            os.sync()
            index[digest] = str(dest.relative_to(MEDIA))
            copied += 1
            total_bytes += dest.stat().st_size
            log(f"[{n}/{len(files)}] {src.name} -> {dest.relative_to(MEDIA)} ok")
            set_status(done=n)
            led.blink(1, 0.03, 0.0)

        write_json(INDEX_PATH, index)

        if copied:
            try:
                os.chown(dest_dir, 1000, 1000)
                for p in dest_dir.iterdir():
                    os.chown(p, 1000, 1000)
            except OSError:
                pass

        result = (f"copied {copied}, skipped {skipped} already held"
                  + (f", {failed} FAILED" if failed else ""))
        log(result)
        set_status(state="idle", last_result=result, last_copied=copied,
                   last_skipped=skipped, last_failed=failed,
                   last_bytes=total_bytes,
                   last_folder=stamp if copied else None)

        if failed:
            led.blink(10, 0.05, 0.05)
            return 1
        led.blink(3, 0.4, 0.25)
        return 0

    finally:
        os.sync()
        umount()


def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} /dev/sdXN", file=sys.stderr)
        return 2

    dev = Path(sys.argv[1])
    MEDIA.mkdir(parents=True, exist_ok=True)

    # udev can fire more than once for the same insertion; serialise.
    lock_fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as exc:
        if exc.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
            log("another offload is already running, exiting")
            return 0
        raise

    led = Led()
    try:
        log(f"=== offload starting for {dev} ===")
        return offload(dev, led)
    except Exception as exc:  # noqa: BLE001 - last resort, must not crash silently
        log(f"unhandled error: {exc!r}")
        set_status(state="error", last_result=repr(exc))
        led.blink(10, 0.05, 0.05)
        return 1
    finally:
        led.restore()
        os.close(lock_fd)


if __name__ == "__main__":
    sys.exit(main())
