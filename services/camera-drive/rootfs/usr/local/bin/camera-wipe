#!/usr/bin/env python3
"""
Delete media from the CAMERA, once it is provably safe to do so.

This is the only component in camera-drive that removes anything. It is a
separate root-owned program rather than part of the web app, so the web app
can run unprivileged and the deletion path stays small enough to audit.

The safety rule, which is absolute:

    A file is deleted from the camera ONLY IF its SHA-256 is already present
    in the Pi's index, meaning a verified copy exists on the Pi's SD card.

Anything that fails to hash, or hashes to something we do not already hold,
is left untouched and reported. There is no --force. If the copy is not
already safely on the Pi, the answer is to run the offload again, not to
override the check.

Usage:
    camera-wipe --dry-run     report what would be deleted
    camera-wipe --commit      actually delete
"""

from __future__ import annotations

import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path("/srv/camera-drive")
INDEX_PATH = ROOT / "index.json"
MOUNT_POINT = Path("/run/camera-drive/wipe-mnt")
LOG_PATH = ROOT / "offload.log"

MEDIA_SUFFIXES = {".jpg", ".jpeg", ".avi", ".mov", ".mp4", ".wav", ".png"}
IGNORED_DIRS = {"System Volume Information", ".fseventsd", ".Spotlight-V100",
                ".Trashes", "LOST.DIR", "FOUND.000"}

CAMERA_VENDOR = "08ca"
CAMERA_PRODUCT_STORAGE = "2023"
CHUNK = 1024 * 1024


def log(msg: str) -> None:
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} [wipe] {msg}"
    print(line, flush=True)
    try:
        with LOG_PATH.open("a") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        while chunk := fh.read(CHUNK):
            h.update(chunk)
    return h.hexdigest()


def udev_prop(dev: str, prop: str) -> str:
    """Ask udev about a device rather than trusting /dev/sda to be the camera."""
    res = subprocess.run(
        ["udevadm", "info", "--query=property", f"--name={dev}"],
        capture_output=True, text=True,
    )
    for line in res.stdout.splitlines():
        key, _, value = line.partition("=")
        if key == prop:
            return value
    return ""


def find_camera_partition() -> str | None:
    """
    Locate the camera by USB vendor/product, never by device name.

    /dev/sda is whatever enumerated first; on a box where the only other
    storage is the SD card that is probably the camera, but 'probably' is not
    good enough for something that deletes files.
    """
    for part in sorted(Path("/dev").glob("sd[a-z][0-9]")):
        dev = str(part)
        vid = udev_prop(dev, "ID_VENDOR_ID").lower()
        pid = udev_prop(dev, "ID_MODEL_ID").lower()
        if vid == CAMERA_VENDOR and pid == CAMERA_PRODUCT_STORAGE:
            return dev
    return None


def mount_rw(dev: str) -> bool:
    MOUNT_POINT.mkdir(parents=True, exist_ok=True)
    if os.path.ismount(MOUNT_POINT):
        subprocess.run(["umount", str(MOUNT_POINT)], check=False,
                       capture_output=True)
    res = subprocess.run(
        ["mount", "-o", "rw,noatime,nosuid,nodev,noexec", dev, str(MOUNT_POINT)],
        capture_output=True, text=True,
    )
    if res.returncode != 0:
        log(f"mount rw failed: {res.stderr.strip()}")
        return False
    return True


def umount() -> None:
    for _ in range(5):
        if not os.path.ismount(MOUNT_POINT):
            return
        if subprocess.run(["umount", str(MOUNT_POINT)],
                          capture_output=True).returncode == 0:
            return
        time.sleep(1.0)
    log("warning: could not unmount after wipe")


def collect_files(root: Path) -> list[Path]:
    found: list[Path] = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in IGNORED_DIRS]
        for name in filenames:
            p = Path(dirpath) / name
            if p.suffix.lower() in MEDIA_SUFFIXES:
                found.append(p)
    return sorted(found)


def main() -> int:
    commit = "--commit" in sys.argv
    if not commit and "--dry-run" not in sys.argv:
        print(__doc__)
        return 2

    result = {"ok": False, "deleted": [], "kept": [], "errors": [],
              "committed": commit}

    try:
        index = json.loads(INDEX_PATH.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        result["errors"].append(f"cannot read index: {exc}")
        print(json.dumps(result))
        return 1

    dev = find_camera_partition()
    if not dev:
        result["errors"].append("camera not connected in storage mode")
        print(json.dumps(result))
        return 1

    if not mount_rw(dev):
        result["errors"].append(f"could not mount {dev} read-write")
        print(json.dumps(result))
        return 1

    try:
        files = collect_files(MOUNT_POINT)
        log(f"{'COMMIT' if commit else 'dry-run'}: {len(files)} file(s) on camera")

        for src in files:
            name = src.name
            try:
                digest = sha256(src)
            except OSError as exc:
                result["errors"].append(f"{name}: unreadable ({exc})")
                result["kept"].append(name)
                continue

            if digest not in index:
                # The whole point of the safety rule.
                log(f"KEEPING {name} -- no verified copy on the Pi")
                result["kept"].append(name)
                continue

            held_at = index[digest]
            if not (ROOT / "media" / held_at).exists():
                log(f"KEEPING {name} -- index claims {held_at} but it is gone")
                result["kept"].append(name)
                result["errors"].append(f"{name}: index points at missing file")
                continue

            if commit:
                try:
                    src.unlink()
                    log(f"deleted {name} (held at {held_at})")
                except OSError as exc:
                    result["errors"].append(f"{name}: delete failed ({exc})")
                    result["kept"].append(name)
                    continue
            else:
                log(f"would delete {name} (held at {held_at})")
            result["deleted"].append(name)

        if commit:
            os.sync()

        result["ok"] = not result["errors"]

    finally:
        os.sync()
        umount()

    print(json.dumps(result))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
