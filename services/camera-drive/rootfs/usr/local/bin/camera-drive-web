  @media (prefers-color-scheme: light){
    :root:not([data-theme="dark"]){
      --bg:#E9E0C9; --panel:#DED3B6; --panel2:#D2C6A4; --line:#8B7F5F;
      --fg:#241F16; --dim:#6A6047;
      --orange:#B0722C; --red:#96382E; --green:#4C6647;
      --shadow:3px 3px 0 #8B7F5F; --scan:rgba(0,0,0,.05);
    }
