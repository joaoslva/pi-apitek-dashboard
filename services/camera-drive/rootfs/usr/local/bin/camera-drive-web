#!/usr/bin/env python3
"""
The phone-facing web UI for camera-drive.

Runs unprivileged as joao. The only privileged things it can do are shell out
to `sudo camera-wipe` (which enforces its own safety rule independently) and
`sudo systemctl poweroff`. This app is never trusted to decide what is safe to
delete.

Live view and camera control work by talking to camera-live through a JSON file
in /run/camera-drive. Both processes run as joao, so there is no socket, no
daemon protocol and no privilege boundary to get wrong. This app never opens
/dev/video0 itself; camera-live owns it, because only one process can.

Recordings are MJPEG in Matroska, which no browser can decode. Default playback
unwraps the JPEG frames they already contain and streams them as multipart,
exactly like the live view -- instant, and no re-encoding at all. An <img> has
no audio channel though, so /api/mp4 transcodes on demand and caches the result
for playback with sound and a seek bar. Note that re-encoding is only slow in
the LIVE capture path (a quarter of realtime); from a file the Pi's hardware
encoder manages 3.3x realtime.

Served by waitress on port 80 so the Pi is reachable at a bare IP from a phone.
"""

from __future__ import annotations

import hashlib
import json
import mimetypes
import os
import shutil
import subprocess
import sys
import tempfile
import time
import zipfile
from datetime import datetime
from pathlib import Path

from flask import (Flask, Response, abort, after_this_request, jsonify,
                   request, send_file, send_from_directory)
from PIL import Image

ROOT = Path("/srv/camera-drive")
MEDIA = ROOT / "media"
VIDEO = ROOT / "video"
THUMBS = ROOT / "thumbs"
PROXY = ROOT / "proxy"
TMP = ROOT / "tmp"
STATUS_PATH = ROOT / "status.json"
RECSTATUS_PATH = ROOT / "recstatus.json"
INDEX_PATH = ROOT / "index.json"

RUN = Path("/run/camera-drive")
LIVE_JPG = RUN / "live.jpg"
CONTROL = RUN / "control.json"

SERVE_ROOTS = (MEDIA, VIDEO)
IMAGE_SUFFIXES = {".jpg", ".jpeg", ".png"}
VIDEO_SUFFIXES = {".avi", ".mov", ".mp4", ".mkv"}
THUMB_PX = 320

# JPEG markers. ffmpeg rewrites live.jpg in place many times a second, so a
# reader can catch a half-written file; frames not ending in EOI are dropped
# rather than shown torn. The same markers split the demuxed playback stream.
JPEG_SOI = b"\xff\xd8\xff"
JPEG_EOI = b"\xff\xd9"

app = Flask(__name__)


# --------------------------------------------------------------------------
# data
# --------------------------------------------------------------------------

def read_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return default


def camera_state() -> dict:
    try:
        out = subprocess.run(["lsusb"], capture_output=True, text=True,
                             timeout=5).stdout.lower()
    except (OSError, subprocess.SubprocessError):
        return {"connected": False, "mode": "unknown"}
    if "08ca:2023" in out:
        return {"connected": True, "mode": "storage"}
    if "08ca:2022" in out:
        return {"connected": True, "mode": "live"}
    return {"connected": False, "mode": "none"}


def disk_state() -> dict:
    u = shutil.disk_usage(ROOT)
    return {"total": u.total, "used": u.total - u.free, "free": u.free,
            "pct": round((u.total - u.free) / u.total * 100, 1)}


def _pretty_folder(name: str) -> str:
    if name == "snapshots":
        return "Snapshots"
    try:
        return datetime.strptime(name, "%Y-%m-%d_%H%M%S").strftime("%d %b %Y, %H:%M")
    except ValueError:
        return name


def list_dumps() -> list[dict]:
    dumps = []
    if not MEDIA.exists():
        return dumps
    for folder in sorted(MEDIA.iterdir(), reverse=True):
        if not folder.is_dir():
            continue
        items = []
        for f in sorted(folder.iterdir(), reverse=True):
            suffix = f.suffix.lower()
            if suffix not in IMAGE_SUFFIXES | VIDEO_SUFFIXES:
                continue
            items.append({"name": f.name,
                          "path": f"media/{folder.name}/{f.name}",
                          "size": f.stat().st_size,
                          "kind": "video" if suffix in VIDEO_SUFFIXES else "image"})
        if items:
            dumps.append({"folder": folder.name,
                          "label": _pretty_folder(folder.name),
                          "count": len(items),
                          "bytes": sum(i["size"] for i in items),
                          "items": items})
    return dumps


def list_recordings() -> list[dict]:
    items = []
    if not VIDEO.exists():
        return items
    for f in sorted(VIDEO.iterdir(), reverse=True):
        if not f.is_file() or f.suffix.lower() not in VIDEO_SUFFIXES:
            continue
        items.append({"name": f.name, "path": f"video/{f.name}",
                      "size": f.stat().st_size,
                      "label": _pretty_folder(f.stem), "kind": "video",
                      "proxy": (PROXY / (f.stem + ".mp4")).exists()})
    return items


def safe_media_path(rel: str) -> Path:
    """Resolve under one of SERVE_ROOTS or refuse. Paths come from URLs and
    form fields, so this is the only thing between a crafted request and the
    rest of the filesystem."""
    target = (ROOT / rel).resolve()
    for base in SERVE_ROOTS:
        if str(target).startswith(str(base.resolve()) + os.sep):
            break
    else:
        abort(404)
    if not target.is_file():
        abort(404)
    return target


# --------------------------------------------------------------------------
# live view and playback
# --------------------------------------------------------------------------

def read_live_frame() -> bytes | None:
    try:
        data = LIVE_JPG.read_bytes()
    except OSError:
        return None
    if len(data) < 1024 or not data.endswith(JPEG_EOI):
        return None
    return data


def control_update(**kw) -> dict:
    cur = read_json(CONTROL, {"preview": False, "recording": False,
                              "snapshot_seq": 0})
    cur.update(kw)
    RUN.mkdir(parents=True, exist_ok=True)
    tmp = CONTROL.with_suffix(".tmp")
    tmp.write_text(json.dumps(cur))
    os.replace(tmp, CONTROL)
    return cur


def multipart(frame: bytes) -> bytes:
    return (b"--frame\r\nContent-Type: image/jpeg\r\n"
            + f"Content-Length: {len(frame)}\r\n\r\n".encode() + frame + b"\r\n")


def live_stream():
    last, idle = None, 0
    while True:
        frame = read_live_frame()
        if frame and frame != last:
            last, idle = frame, 0
            yield multipart(frame)
        else:
            idle += 1
            # Viewfinder switched off or camera unplugged: end the stream
            # rather than holding a waitress thread open forever.
            if idle > 60:
                return
        time.sleep(0.08)


def play_stream(path: Path):
    """
    Play a recording by unwrapping the JPEG frames it already contains.

    -re paces ffmpeg at the file's native rate so playback runs at real speed,
    and -c:v copy means no decoding or re-encoding happens anywhere.
    """
    proc = subprocess.Popen(
        ["ffmpeg", "-v", "error", "-re", "-i", str(path),
         "-c:v", "copy", "-f", "image2pipe", "-"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
    buf = b""
    try:
        while True:
            chunk = proc.stdout.read(65536)
            if not chunk:
                break
            buf += chunk
            while True:
                end = buf.find(JPEG_EOI)
                if end == -1:
                    break
                frame, buf = buf[:end + 2], buf[end + 2:]
                start = frame.find(JPEG_SOI)
                if start != -1:
                    yield multipart(frame[start:])
    except GeneratorExit:
        pass
    finally:
        proc.kill()
        proc.wait(timeout=5)


# --------------------------------------------------------------------------
# thumbnails
# --------------------------------------------------------------------------

def thumb_for(rel: str) -> Path | None:
    src = safe_media_path(rel)
    key = hashlib.sha256(f"{rel}:{src.stat().st_mtime_ns}".encode()).hexdigest()[:32]
    dest = THUMBS / f"{key}.jpg"
    if dest.exists():
        return dest
    THUMBS.mkdir(parents=True, exist_ok=True)
    suffix = src.suffix.lower()
    try:
        if suffix in IMAGE_SUFFIXES:
            with Image.open(src) as im:
                im = im.convert("RGB")
                im.thumbnail((THUMB_PX, THUMB_PX))
                im.save(dest, "JPEG", quality=80)
        elif suffix in VIDEO_SUFFIXES:
            # Seek in a little: frame 0 is often the lens cap, or a frame the
            # auto-exposure has not settled on yet.
            for args in (["-ss", "1", "-i", str(src)], ["-i", str(src)]):
                subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error",
                                *args, "-frames:v", "1",
                                "-vf", f"scale={THUMB_PX}:-1", "-y", str(dest)],
                               check=False, capture_output=True, timeout=90)
                if dest.exists():
                    break
        else:
            return None
    except Exception:
        return None
    return dest if dest.exists() else None


# --------------------------------------------------------------------------
# routes
# --------------------------------------------------------------------------

@app.get("/api/state")
def api_state():
    return jsonify({
        "camera": camera_state(),
        "disk": disk_state(),
        "status": read_json(STATUS_PATH, {}),
        "recstatus": read_json(RECSTATUS_PATH, {}),
        "control": read_json(CONTROL, {}),
        "live": LIVE_JPG.exists(),
        "held": len(read_json(INDEX_PATH, {})),
        "dumps": list_dumps(),
        "recordings": list_recordings(),
    })


@app.get("/api/stream")
def api_stream():
    if not LIVE_JPG.exists():
        abort(503)
    return Response(live_stream(),
                    mimetype="multipart/x-mixed-replace; boundary=frame")


@app.get("/api/play/<path:rel>")
def api_play(rel: str):
    path = safe_media_path(rel)
    if path.suffix.lower() not in VIDEO_SUFFIXES:
        abort(400)
    return Response(play_stream(path),
                    mimetype="multipart/x-mixed-replace; boundary=frame")


@app.get("/api/live.jpg")
def api_live_jpg():
    frame = read_live_frame()
    if not frame:
        abort(503)
    return Response(frame, mimetype="image/jpeg",
                    headers={"Cache-Control": "no-store"})


@app.post("/api/control")
def api_control():
    body = request.json or {}
    out = {}
    if "preview" in body:
        out = control_update(preview=bool(body["preview"]))
    if "recording" in body:
        # Recording implies the capture pipeline, so switching it on also
        # turns the viewfinder on rather than fighting with it.
        kw = {"recording": bool(body["recording"])}
        if body["recording"]:
            kw["preview"] = True
        out = control_update(**kw)
    if body.get("snapshot"):
        cur = read_json(CONTROL, {})
        out = control_update(snapshot_seq=int(cur.get("snapshot_seq", 0)) + 1)
    if not out:
        return jsonify({"ok": False, "error": "nothing to do"}), 400
    return jsonify({"ok": True, "control": out})


@app.post("/api/power")
def api_power():
    """Shut the Pi down cleanly. Pulling the plug on a running Pi is the
    reliable way to corrupt an SD card eventually."""
    try:
        # Fire and forget: systemd takes a few seconds to actually halt, which
        # is long enough for this response to reach the phone.
        subprocess.Popen(["sudo", "-n", "systemctl", "poweroff"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        return jsonify({"ok": False, "error": str(exc)}), 500
    return jsonify({"ok": True})


@app.get("/api/mp4/<path:rel>")
def api_mp4(rel: str):
    """
    An H.264 + AAC copy of a recording, so it plays in a real <video> element
    with sound and a seek bar. Transcoded once on demand, then cached.

    The in-app MJPEG preview stays the default because it is instant and free;
    this is the "I want the audio" path. Measured on this Pi: the hardware
    encoder does 3.3x realtime, so a one minute clip takes about 18 seconds.

    h264_v4l2m2m only produced invalid output in the live-capture pipeline,
    where it was paired with fragmented MP4. From a file into a normal
    +faststart MP4 it is fine -- but fall back to libx264 if it ever is not.
    """
    src = safe_media_path(rel)
    if src.suffix.lower() not in VIDEO_SUFFIXES:
        abort(400)
    PROXY.mkdir(parents=True, exist_ok=True)
    dest = PROXY / (src.stem + ".mp4")

    if not dest.exists():
        tmp = dest.with_suffix(".part")
        # -f mp4 is REQUIRED, not decorative. ffmpeg picks its muxer from the
        # output file extension, and the ".part" name (used so a half-written
        # transcode is never served) means nothing to it -- without this it
        # fails instantly with "unable to find a suitable output format".
        common = ["-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "96k",
                  "-movflags", "+faststart", "-f", "mp4", "-y", str(tmp)]
        for vcodec in (["-c:v", "h264_v4l2m2m", "-b:v", "1500k"],
                       ["-c:v", "libx264", "-preset", "veryfast", "-crf", "26"]):
            try:
                subprocess.run(["ffmpeg", "-v", "error", "-i", str(src),
                                *vcodec, *common],
                               check=False, capture_output=True, timeout=3600)
            except subprocess.SubprocessError:
                continue
            # A valid result must both exist and decode.
            if tmp.exists() and tmp.stat().st_size > 1024:
                probe = subprocess.run(
                    ["ffprobe", "-v", "error", "-show_entries",
                     "format=duration", "-of", "csv=p=0", str(tmp)],
                    capture_output=True, text=True)
                if probe.returncode == 0 and probe.stdout.strip():
                    break
            tmp.unlink(missing_ok=True)
        if not tmp.exists():
            abort(500)
        os.replace(tmp, dest)

    # conditional=True gives range requests, which is what makes seeking work.
    return send_file(dest, mimetype="video/mp4", conditional=True)


@app.get("/media/<path:rel>")
def media(rel: str):
    path = safe_media_path(rel)
    mime, _ = mimetypes.guess_type(path.name)
    # Browsers cannot decode MJPEG/Matroska, and left to themselves they show
    # a bare "no supported source" error. Send video as a download instead;
    # in-app playback goes through /api/play.
    as_attach = path.suffix.lower() in VIDEO_SUFFIXES or "dl" in request.args
    return send_file(path, mimetype=mime or "application/octet-stream",
                     conditional=True, as_attachment=as_attach,
                     download_name=path.name if as_attach else None)


@app.get("/thumb/<path:rel>")
def thumb(rel: str):
    t = thumb_for(rel)
    if not t:
        abort(404)
    return send_from_directory(t.parent, t.name, mimetype="image/jpeg",
                               max_age=86400)


@app.post("/api/zip")
def api_zip():
    """
    Bundle the selected files. Submitted as a normal form so the browser
    handles the download itself instead of buffering a blob in phone memory.

    ZIP_STORED, not DEFLATE: JPEG and MJPEG are already compressed, so
    deflating them burns CPU on a Zero 2 W to save almost nothing.
    """
    rels = request.form.getlist("path")
    if not rels:
        abort(400)
    paths = [safe_media_path(r) for r in rels[:500]]

    TMP.mkdir(parents=True, exist_ok=True)
    fd, tmpname = tempfile.mkstemp(suffix=".zip", dir=TMP)
    os.close(fd)
    tmppath = Path(tmpname)

    with zipfile.ZipFile(tmppath, "w", zipfile.ZIP_STORED) as z:
        for p in paths:
            z.write(p, arcname=p.name)

    @after_this_request
    def cleanup(response):
        try:
            tmppath.unlink(missing_ok=True)
        except OSError:
            pass
        return response

    stamp = datetime.now().strftime("%Y-%m-%d_%H%M")
    return send_file(tmppath, mimetype="application/zip", as_attachment=True,
                     download_name=f"camera-drive_{stamp}.zip")


@app.post("/api/wipe")
def api_wipe():
    commit = bool(request.json and request.json.get("commit"))
    flag = "--commit" if commit else "--dry-run"
    try:
        res = subprocess.run(["sudo", "-n", "/usr/local/bin/camera-wipe", flag],
                             capture_output=True, text=True, timeout=900)
    except subprocess.SubprocessError as exc:
        return jsonify({"ok": False, "errors": [str(exc)]}), 500
    try:
        payload = json.loads(res.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return jsonify({"ok": False,
                        "errors": ["could not parse camera-wipe output",
                                   res.stdout[-400:], res.stderr[-400:]]}), 500
    return jsonify(payload)


@app.get("/")
def index() -> Response:
    return Response(PAGE, mimetype="text/html")


# --------------------------------------------------------------------------
# the page
# --------------------------------------------------------------------------

# Pixel-art camera on a 16x16 grid, crisp-edged so it stays blocky at any size.
_ICON_BODY = (
    "<rect x='5' y='1' width='4' height='2' fill='{o}'/>"
    "<rect x='1' y='3' width='14' height='11' fill='{o}'/>"
    "<rect x='4' y='5' width='8' height='8' fill='{d}'/>"
    "<rect x='5' y='6' width='6' height='6' fill='{g}'/>"
    "<rect x='7' y='8' width='2' height='2' fill='{l}'/>"
    "<rect x='12' y='4' width='2' height='2' fill='{r}'/>"
)
ICON_INLINE = ("<svg viewBox='0 0 16 16' shape-rendering='crispEdges'>"
               + _ICON_BODY.format(o="#DFA05D", d="#17150F", g="#658761",
                                   l="#EDE4D3", r="#AC5045") + "</svg>")
ICON_URI = ("data:image/svg+xml,"
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' "
            "shape-rendering='crispEdges'>"
            "<rect width='16' height='16' fill='%2317150F'/>"
            + _ICON_BODY.format(o="%23DFA05D", d="%2317150F", g="%23658761",
                                l="%23EDE4D3", r="%23AC5045") + "</svg>")

PAGE = r"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<title>CAMERA-DRIVE</title>
<link rel="icon" href="__ICON_URI__">
<style>
  /* Dark is the primary design; light is a full re-skin of the same tokens. */
  :root{
    --bg:#17150F; --panel:#211E18; --panel2:#2B2720; --line:#4A4133;
    --fg:#EDE4D3; --dim:#9A8F7C;
    --orange:#DFA05D; --red:#AC5045; --green:#658761;
    --shadow:3px 3px 0 #0c0b08; --scan:rgba(0,0,0,.16);
